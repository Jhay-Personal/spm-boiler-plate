{
  "name": "admin-portal",
  "version": "2.0.0",
  "private": true,
  "description": "A TypeScript admin portal boiler-plate: session auth, server-enforced role-based module access, user management, and light/dark theming.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "init-db": "tsx scripts/init-db.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:all": "npm run test && npm run build && npm run test:api",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:api"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.8",
    "next": "^16.3.0",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7"
  }
}
