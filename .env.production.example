# ---------------------------------------------------------------------------
# Admin Portal — PRODUCTION environment template
#
# Copy to `.env.production` and fill in. `.env.production` is gitignored.
# Inject these from your platform's secret store at deploy time; never commit
# real values and never reuse them across environments.
# ---------------------------------------------------------------------------

NODE_ENV=production

# Managed Postgres — TLS on, certificate chain verified.
DATABASE_URL=
DATABASE_SSL=true
# Set only if your provider's CA is not in the system trust store.
# DATABASE_CA_CERT=

# openssl rand -base64 48
# Rotating this signs every user out; that is the intended emergency response
# to a suspected token compromise.
AUTH_SECRET=

# Must be a persistent volume. A container-local path loses every profile
# photo on redeploy.
UPLOAD_DIR=/var/lib/admin-portal/uploads

# Only used the first time the database is initialised. Rotate the password
# through the UI after the first sign-in.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
