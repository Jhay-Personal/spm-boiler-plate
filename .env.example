# ---------------------------------------------------------------------------
# 2ni Admin Portal — environment configuration
# Copy this file to `.env` and fill in the values, then run `npm run init-db`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Point this at the SAME database that runs your viral content pipeline
# (the one holding viral_posts / generated_content) so the dashboard has data.
# Examples:
#   postgres://user:password@localhost:5432/twoni
#   postgres://user:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/twoni

# Set to "true" if your Postgres requires SSL (most cloud providers do:
# Supabase, Neon, Render, Heroku). Leave "false" for a local database.
DATABASE_SSL=false

# Secret used to sign login session tokens (JWT). Use a long random string.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-secret-string

# The default admin account created by `npm run init-db`.
# These match the project spec; change them before going to production.
SEED_ADMIN_EMAIL=admin@email.com
SEED_ADMIN_PASSWORD=123123123
