# ---------------------------------------------------------------------------
# Admin Portal — environment configuration (local development)
#
# Copy to `.env`, fill in every value, then run `npm run init-db`.
# There are no fallback defaults: the app fails to start rather than run with
# a guessed secret.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# PostgreSQL connection string.
#   postgres://user:password@localhost:5432/admin_portal
DATABASE_URL=postgres://postgres:postgres@localhost:5432/admin_portal

# "true" if your Postgres requires TLS (Supabase, Neon, Render, Heroku all do).
DATABASE_SSL=false

# Optional PEM CA certificate for the database connection. The certificate
# chain is ALWAYS verified when DATABASE_SSL=true; set this only when your
# provider uses a CA that isn't in the system trust store. Literal "\n"
# escapes are accepted.
# DATABASE_CA_CERT=

# --- Sessions --------------------------------------------------------------
# Signs the session JWT. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 48
# Changing it signs everybody out.
AUTH_SECRET=

# --- Uploads ---------------------------------------------------------------
# Where profile photos are written. Deliberately OUTSIDE public/ — files under
# public/ are served statically to anyone, bypassing every access check. These
# are served instead by the authenticated /api/uploads/:name route.
UPLOAD_DIR=./data/uploads

# --- First admin account ---------------------------------------------------
# Used by `npm run init-db` to create the initial super admin. The account is
# created once; re-running never overwrites an existing password.
# Must be at least 12 characters. Generate one with: openssl rand -base64 24
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
