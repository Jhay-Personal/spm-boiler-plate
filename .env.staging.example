# ---------------------------------------------------------------------------
# Admin Portal — STAGING environment template
#
# Copy to `.env.staging` and fill in. `.env.staging` is gitignored: real values
# belong in your platform's secret store (GCP Secret Manager, AWS Secrets
# Manager / SSM Parameter Store), not in the repository.
# ---------------------------------------------------------------------------

NODE_ENV=production

# Managed Postgres — TLS on, certificate chain verified.
DATABASE_URL=
DATABASE_SSL=true
# DATABASE_CA_CERT=

# Must differ from production, so a leaked staging secret cannot mint
# production sessions.
AUTH_SECRET=

# Use a mounted volume so photos survive redeploys.
UPLOAD_DIR=/var/lib/admin-portal/uploads

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
